{
	"profiles": {
		"Terraria": {
			"commandName": "Executable",
			"executablePath": "$(TModLoaderDotNetPath)",
			"commandLineArgs": "$(tMLPath)",
			"workingDirectory": "$(tMLSteamPath)",
			"environmentVariables": {
				"DYLD_LIBRARY_PATH": "$(TModLoaderNativeLibraryPath)",
				"VK_ICD_FILENAMES": "$(TModLoaderNativeLibraryPath)/MoltenVK_icd.json"
			}
		},
		"TerrariaServer": {
			"commandName": "Executable",
			"executablePath": "$(TModLoaderDotNetPath)",
			"commandLineArgs": "$(tMLServerPath) -nosteam -config \"$(MSBuildProjectDirectory)/serverconfig.local.txt\"",
			"workingDirectory": "$(tMLSteamPath)",
			"environmentVariables": {
				"DYLD_LIBRARY_PATH": "$(TModLoaderNativeLibraryPath)",
				"VK_ICD_FILENAMES": "$(TModLoaderNativeLibraryPath)/MoltenVK_icd.json"
			}
		}
	}
}
